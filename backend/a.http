### Cấu hình biến môi trường (Sửa port nếu cần)
@baseUrl1 = http://localhost:3000/api/device
@deviceId = ESP32_001

### =============================================
### 1. KIỂM TRA TRẠNG THÁI THIẾT BỊ
### =============================================
GET http://localhost:5001/api/report/weekly
Content-Type: application/json

### =============================================
### 2. TEST TẮT ĐÈN THỦ CÔNG (MANUAL OFF)
### Mong đợi: Đèn TẮT + Auto Mode bị KHÓA (false)
### =============================================
POST http://localhost:5001/api/device/manual-power
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjY5M2VkNmFhM2NhMDE2MzAxZWNlMzY2OCIsImlhdCI6MTc2NTc5MjI5NSwiZXhwIjoxNzY4Mzg0Mjk1fQ.16BUuyOPqCLmrMPtsP7snkoTAvpF1DydVQi8neOhAvc

{
    "deviceId": "{{deviceId}}",
    "newPowerState": "OFF"
}

### =============================================
### 3. TEST BẬT ĐÈN THỦ CÔNG (MANUAL ON)
### Mong đợi: Đèn BẬT + Auto Mode bị KHÓA (false)
### =============================================
POST http://localhost:5001/api/device/enable-auto
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjY5M2VkNmFhM2NhMDE2MzAxZWNlMzY2OCIsImlhdCI6MTc2NTc5MjI5NSwiZXhwIjoxNzY4Mzg0Mjk1fQ.16BUuyOPqCLmrMPtsP7snkoTAvpF1DydVQi8neOhAvc

{
    "deviceId": "{{deviceId}}",
    "newPowerState": "ON"
}

### =============================================
### 4. TEST BẬT LẠI CHẾ ĐỘ TỰ ĐỘNG (ENABLE AUTO)
### Mong đợi: Auto Mode được MỞ (true)
### =============================================
POST {{baseUrl}}/enable-auto
Content-Type: application/json
Authorization: Bearer

{
    "deviceId": "{{deviceId}}"
}

### =============================================

